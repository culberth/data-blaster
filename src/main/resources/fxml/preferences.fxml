<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  The canonical surface for the settings that persist, one tab per scope.

  Every control here writes the same AppState the ribbon does; there is no second copy of any value.
  Edits apply immediately, so the button is Close rather than OK/Cancel: a Cancel would need
  somewhere to hold uncommitted edits, and that buffer is exactly the duplicated state this dialog
  was reworked to remove. Reset to defaults is the way back, and it is per tab.

  Tabs rather than only the current mode's settings: configuring Message mode while running in Log
  mode is the normal case, not the exception, and a dialog whose contents change shape under the
  user is worse than four tabs.

  REST has no tab because it has no settings. A tab that said "nothing here" would be a promise that
  something is coming; the mode toggle already carries that message.

  Each tab is its own FXML with its own prototype-scoped controller, matching the pattern the ribbon
  groups use. This file wires them together and owns nothing but the Close button.
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.culberth.tools.datablaster.controller.PreferencesController"
      spacing="12" prefWidth="520" prefHeight="470">
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <!--
      No "Preferences" heading: the title bar already says it, and repeating it costs a line of
      vertical space to tell the user something they just read.
    -->
    <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="General">
            <fx:include source="preferences/general-tab.fxml"/>
        </Tab>
        <Tab text="Log">
            <fx:include source="preferences/log-tab.fxml"/>
        </Tab>
        <Tab text="Message">
            <fx:include source="preferences/message-tab.fxml"/>
        </Tab>
        <Tab text="SOAP">
            <fx:include source="preferences/soap-tab.fxml"/>
        </Tab>
    </TabPane>

    <Separator/>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Close" defaultButton="true" cancelButton="true" onAction="#onClose"/>
    </HBox>
</VBox>
