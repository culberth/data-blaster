<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  The Log tab: playback speed, the capture folder, and the port-to-tail-number table.

  Playback Speed is a Spinner here and a log-scaled slider in the ribbon. Neither owns the value:
  both read and write AppState. The spinner is for typing an exact number, which is what a settings
  dialog is for; the slider is for scrubbing, which is what a ribbon is for.

  The mapping table rejects bad entries at the moment they are entered, with the reason shown beside
  the controls — not on close, and not in a modal. The reason text comes straight from the
  exception PortTailMapping throws, which is written to be read by a person.
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.culberth.tools.datablaster.controller.preferences.LogTabController"
      spacing="12">
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <HBox spacing="16" alignment="CENTER_LEFT">
        <VBox spacing="4">
            <Label fx:id="playbackSpeedCaption" text="Playback Speed _Factor" mnemonicParsing="true"
                   styleClass="dialog-field-label"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Spinner fx:id="playbackSpeedSpinner" editable="true" prefWidth="110"
                         accessibleText="Playback speed factor"/>
                <Label text="× real time" styleClass="dialog-hint"/>
            </HBox>
        </VBox>
    </HBox>
    <Label text="1.0 is real time; 2.0 is twice as fast, 0.5 is half speed."
           styleClass="dialog-hint" wrapText="true"/>

    <VBox spacing="4">
        <Label text="Log folder" styleClass="dialog-field-label"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button text="_Browse…" mnemonicParsing="true" onAction="#onChooseLogFolder"
                    accessibleText="Choose log folder"/>
            <Label fx:id="logFolderLabel" text="(none selected)" styleClass="dialog-readout"
                   maxWidth="340" textOverrun="CENTER_ELLIPSIS" HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>

    <Separator/>

    <Label fx:id="mappingsCaption" text="Port → tail number" styleClass="dialog-field-label"/>

    <!--
      Sorting is disabled on both columns deliberately. The items list is AppState's unmodifiable
      view, and a sort would try to reorder it in place; the entries arrive in port order anyway.
    -->
    <TableView fx:id="mappingTable" styleClass="mapping-table" editable="true"
               prefHeight="150" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="portColumn" text="Port" prefWidth="90" sortable="false"/>
            <TableColumn fx:id="tailColumn" text="Tail No." prefWidth="120" sortable="false"/>
        </columns>
    </TableView>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="newPortField" promptText="Port" prefWidth="90"
                   accessibleText="Port for a new mapping"/>
        <TextField fx:id="newTailField" promptText="Tail No." prefWidth="120"
                   accessibleText="Tail number for a new mapping"/>
        <Button fx:id="addButton" text="_Add" mnemonicParsing="true" onAction="#onAddMapping"/>
        <Button fx:id="removeButton" text="Re_move" mnemonicParsing="true"
                onAction="#onRemoveMapping"/>
    </HBox>

    <!--
      No accessibleText on either of these: they are read-outs, and accessibleText on a Label
      overrides the very text it exists to announce.
    -->
    <Label fx:id="mappingErrorLabel" styleClass="dialog-warning" wrapText="true" managed="false"
           visible="false"/>
    <Label fx:id="portCollisionLabel" styleClass="dialog-warning" wrapText="true" managed="false"
           visible="false"/>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="resetButton" text="_Reset this tab" mnemonicParsing="true"
                onAction="#onResetToDefaults"
                accessibleText="Reset the Log settings to their defaults"/>
        <Label text="Clears the mapping table; asks first." styleClass="dialog-hint"/>
    </HBox>
</VBox>
