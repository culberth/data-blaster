<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  The SOAP tab: the port the mode will listen on.

  It has no ribbon group. A listen port is set once and then forgotten, and a ribbon is for controls
  reached for repeatedly, so putting it there would have meant a set-once value one mis-click from
  every session.

  The port is validated for range and never checked for availability. Whether it is free is a
  bind-time question, and the mode behaviour that would bind it does not exist yet.
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.culberth.tools.datablaster.controller.preferences.SoapTabController"
      spacing="14">
    <padding>
        <Insets top="14" right="14" bottom="14" left="14"/>
    </padding>

    <VBox spacing="4">
        <Label fx:id="portCaption" text="_Port" mnemonicParsing="true"
               styleClass="dialog-field-label"/>
        <Spinner fx:id="portSpinner" editable="true" prefWidth="120"
                 accessibleText="SOAP listen port"/>
        <Label text="1 to 65535. Not checked for availability: that is a bind-time question, and
                     nothing binds it yet."
               styleClass="dialog-hint" wrapText="true"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="resetButton" text="_Reset this tab" mnemonicParsing="true"
                onAction="#onResetToDefaults"
                accessibleText="Reset the SOAP settings to their defaults"/>
    </HBox>
</VBox>
