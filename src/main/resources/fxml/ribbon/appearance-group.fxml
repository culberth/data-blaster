<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  The "Appearance" ribbon group: the content opacity, and nothing else.

  The template's Sim Factor slider lived here. It became Log mode's Playback Speed Factor, which is
  not an appearance setting and does not belong in this group — and as a multiplier over 0.1-10.0 it
  is not a slider any more either: a linear track puts 1.0, the default and the value you return to,
  at 9% of its travel. It is a Spinner in Preferences now. If a quick-access control is ever wanted
  in the ribbon it belongs in a mode-aware group, on a log scale.
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.culberth.tools.datablaster.controller.ribbon.AppearanceGroupController"
      styleClass="ribbon-group">

    <HBox styleClass="ribbon-group-buttons" spacing="12">
        <VBox alignment="CENTER" spacing="2">
            <Label fx:id="opacityCaption" text="Opacity" styleClass="ribbon-slider-label"/>
            <HBox alignment="CENTER" spacing="6">
                <Slider fx:id="opacitySlider" accessibleText="Content opacity"
                        min="0.3" max="1.0" value="1.0" prefWidth="90"/>
                <Label fx:id="opacityValueLabel" text="100%" styleClass="ribbon-readout"/>
                <Button fx:id="opacityResetButton" text="Reset" styleClass="ribbon-inline-button"
                        onAction="#onResetOpacity"
                        accessibleText="Reset content opacity to 100%"/>
            </HBox>
        </VBox>
    </HBox>
    <Label text="Appearance" styleClass="ribbon-group-title"/>
</VBox>
