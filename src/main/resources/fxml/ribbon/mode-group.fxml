<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Rectangle?>

<!--
  The "Mode" ribbon group. Each toggle carries the view id it selects in its userData, so the
  id-to-button mapping is declared here rather than hardcoded in four handler methods.
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.culberth.tools.datablaster.controller.ribbon.ModeGroupController"
      styleClass="ribbon-group">
    <fx:define>
        <ToggleGroup fx:id="modeGroup"/>
    </fx:define>

    <HBox styleClass="ribbon-group-buttons" spacing="4">
        <ToggleButton text="View 1" contentDisplay="TOP" styleClass="ribbon-button"
                      toggleGroup="$modeGroup" selected="true" onAction="#onModeSelected">
            <userData><String fx:value="view1"/></userData>
            <graphic>
                <Group>
                    <Rectangle styleClass="ribbon-icon-shape" x="0" y="0" width="22" height="16" arcWidth="3" arcHeight="3" fill="TRANSPARENT" strokeWidth="1.5"/>
                </Group>
            </graphic>
        </ToggleButton>
        <ToggleButton text="View 2" contentDisplay="TOP" styleClass="ribbon-button"
                      toggleGroup="$modeGroup" onAction="#onModeSelected">
            <userData><String fx:value="view2"/></userData>
            <graphic>
                <Group>
                    <Rectangle styleClass="ribbon-icon-shape" x="0" y="0" width="22" height="16" arcWidth="3" arcHeight="3" fill="TRANSPARENT" strokeWidth="1.5"/>
                    <Line styleClass="ribbon-icon-shape" startX="11" startY="0" endX="11" endY="16" strokeWidth="1.5"/>
                </Group>
            </graphic>
        </ToggleButton>
        <ToggleButton text="View 3" contentDisplay="TOP" styleClass="ribbon-button"
                      toggleGroup="$modeGroup" onAction="#onModeSelected">
            <userData><String fx:value="view3"/></userData>
            <graphic>
                <Group>
                    <Rectangle styleClass="ribbon-icon-shape" x="0" y="0" width="22" height="16" arcWidth="3" arcHeight="3" fill="TRANSPARENT" strokeWidth="1.5"/>
                    <Line styleClass="ribbon-icon-shape" startX="11" startY="0" endX="11" endY="16" strokeWidth="1.5"/>
                    <Line styleClass="ribbon-icon-shape" startX="0" startY="8" endX="22" endY="8" strokeWidth="1.5"/>
                </Group>
            </graphic>
        </ToggleButton>
        <ToggleButton text="View 4" contentDisplay="TOP" styleClass="ribbon-button"
                      toggleGroup="$modeGroup" onAction="#onModeSelected">
            <userData><String fx:value="view4"/></userData>
            <graphic>
                <Group>
                    <!--
                      Invisible 22x16 bounding box so this icon occupies the same height as the
                      three rectangle-based ones; matching the stroke weight alone still left the
                      glyph 4px shorter, which pushed the View 4 caption 2px above its siblings.
                    -->
                    <Rectangle x="0" y="0" width="22" height="16" fill="TRANSPARENT" stroke="TRANSPARENT" strokeWidth="1.5"/>
                    <Line styleClass="ribbon-icon-shape" startX="0" startY="2" endX="22" endY="2" strokeWidth="1.5"/>
                    <Line styleClass="ribbon-icon-shape" startX="0" startY="8" endX="22" endY="8" strokeWidth="1.5"/>
                    <Line styleClass="ribbon-icon-shape" startX="0" startY="14" endX="22" endY="14" strokeWidth="1.5"/>
                </Group>
            </graphic>
        </ToggleButton>
    </HBox>
    <Label text="Mode" styleClass="ribbon-group-title"/>
</VBox>
