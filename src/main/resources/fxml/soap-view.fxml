<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  The SOAP mode view: its settings, and an honest note that the mode does nothing yet.

  The address is shown but nothing connects to it, and the data files are listed but nothing reads
  them. Whether the address is reachable and whether the files exist are both questions the
  behaviour would ask, and the behaviour does not exist.

  The data files are shown as a count rather than a list, the way the Log view shows its mapping
  count: this is a read-out of how the mode is configured, and the place to see and change the list
  itself is the one place that can change it.
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.culberth.tools.datablaster.controller.SoapViewController"
      spacing="14" VBox.vgrow="ALWAYS">
    <padding>
        <Insets top="28" right="28" bottom="28" left="28"/>
    </padding>

    <Label text="SOAP" styleClass="mode-view-title"/>
    <Label text="Configured in Preferences; it does not do anything yet. The settings below are live — they are what this mode will use once it is built." styleClass="mode-view-note" wrapText="true"/>

    <VBox spacing="6">
        <HBox spacing="8">
            <Label text="SOAP IP" styleClass="mode-view-caption" minWidth="130"/>
            <Label fx:id="ipValue" styleClass="mode-view-value" wrapText="true"/>
        </HBox>
        <HBox spacing="8">
            <Label text="Message type" styleClass="mode-view-caption" minWidth="130"/>
            <Label fx:id="messageTypeValue" styleClass="mode-view-value" wrapText="true"/>
        </HBox>
        <HBox spacing="8">
            <Label text="Data files" styleClass="mode-view-caption" minWidth="130"/>
            <Label fx:id="dataFileCountValue" styleClass="mode-view-value" wrapText="true"/>
        </HBox>
        <HBox spacing="8">
            <Label text="Tail number" styleClass="mode-view-caption" minWidth="130"/>
            <Label fx:id="tailValue" styleClass="mode-view-value" wrapText="true"/>
        </HBox>
    </VBox>
</VBox>
